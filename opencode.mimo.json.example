{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "ask",
    "bash": {
      "git push*": "ask",
      "rm -rf*": "deny"
    }
  },
  "provider": {
    "mimo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Xiaomi MiMo",
      "options": {
        "baseURL": "https://api.xiaomimimo.com/v1"
      },
      "models": {
        "mimo-v2.6-pro": {
          "name": "MiMo V2.6 Pro",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "mimo-v2.6-flash": {
          "name": "MiMo V2.6 Flash",
          "limit": {
            "context": 256000,
            "output": 64000
          }
        },
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro (fallback)",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  },
  "model": "mimo/mimo-v2.6-pro",
  "small_model": "mimo/mimo-v2.6-flash",
  "agent": {
    "qa-unit": {
      "model": "mimo/mimo-v2.6-flash"
    },
    "qa-contrato": {
      "model": "mimo/mimo-v2.6-flash"
    },
    "qa-e2e": {
      "model": "mimo/mimo-v2.6-flash"
    },
    "qa-security": {
      "model": "mimo/mimo-v2.6-flash"
    },
    "qa-quality": {
      "model": "mimo/mimo-v2.6-flash"
    },
    "web-researcher": {
      "model": "mimo/mimo-v2.6-flash"
    },
    "plat-docs": {
      "model": "mimo/mimo-v2.6-flash"
    }
  }
}
